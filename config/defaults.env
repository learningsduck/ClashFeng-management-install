# ClashFeng 安装默认配置（可被 install-info.env 覆盖）
INSTALL_DIR=/opt/clashfeng
COMPOSE_DIR=/opt/clashfeng/compose
APP_DIR=/opt/clashfeng/app
AUTH_REPO_URL=https://github.com/learningsduck/ClashFeng-auth.git
AUTH_REPO_BRANCH=main

MYSQL_DATABASE=clashwin_auth
MYSQL_USER=clashwin
MYSQL_PORT=3306

APP_PORT=3001
NODE_ENV=production
REQUIRE_HTTPS=true

JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=30
